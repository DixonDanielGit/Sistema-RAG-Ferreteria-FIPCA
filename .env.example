# Copia este archivo como .env y ajusta los valores.
# .env esta ignorado por Git: nunca subas credenciales reales.

# Credenciales de PostgreSQL (contenedor db) - cuenta de administracion
POSTGRES_USER=admin_ferreteria
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=ferreteria
POSTGRES_HOST_PORT=5432

# Contrasena del rol de aplicacion "app_ferreteria" (minimo 16 caracteres).
# init.sql lo crea con permisos de datos, sin privilegios de estructura.
APP_DB_PASSWORD=cambia_esta_clave_de_aplicacion

# Puerto publicado para la API (contenedor api). Cambialo si el 8000 esta ocupado.
API_HOST_PORT=8000

# Interfaz de red donde se publican los puertos.
# 127.0.0.1 = solo local (recomendado). En un VPS usa 0.0.0.0 + firewall.
BIND_ADDRESS=127.0.0.1

# Credenciales de pgAdmin (contenedor pgadmin, http://localhost:8080)
PGADMIN_DEFAULT_EMAIL=admin@ferreteria.com
PGADMIN_DEFAULT_PASSWORD=cambia_esta_clave
PGADMIN_HOST_PORT=8080

# ---------------------------------------------------------------------
# Aplicacion FastAPI
# ---------------------------------------------------------------------

# Conexion de la aplicacion: usa el rol de minimo privilegio, no el admin.
DATABASE_URL_RAG=postgresql://app_ferreteria:cambia_esta_clave_de_aplicacion@localhost:5432/ferreteria_rag
DATABASE_URL_USUARIOS=postgresql://app_ferreteria:cambia_esta_clave_de_aplicacion@localhost:5432/ferreteria_usuarios

# Conexion de administracion: solo para tareas puntuales (crear bases de
# prueba, migraciones manuales). La API no la utiliza.
ADMIN_DATABASE_URL=postgresql://admin_ferreteria:cambia_esta_clave@localhost:5432/ferreteria

# Clave de firma de los JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esta_clave_de_firma
JWT_ALGORITHM=HS256
JWT_EXPIRACION_MINUTOS=30
JWT_EMISOR=ferreteria-fipca

# Entorno: desarrollo | produccion (en produccion se exige JWT_SECRET propia)
ENTORNO=desarrollo

# Origenes permitidos para AJAX (separados por coma)
CORS_ORIGENES=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------
# Interfaz web (Adenda 1)
# ---------------------------------------------------------------------

# Origen con el que el navegador abre la aplicacion. Debe coincidir con la
# barra de direcciones: el enlace de recuperacion y la validacion de origen
# (CSRF) se construyen con este valor.
URL_BASE=http://localhost:8000
CONFIAR_EN_PROXY=false

# Cookies de sesion y CSRF. COOKIE_SEGURA vacio = automatico (solo HTTPS en
# produccion); true = exigir HTTPS siempre.
COOKIE_NOMBRE=access_token
COOKIE_CSRF=csrf_token
COOKIE_SEGURA=

# Directorio local de originales ETL (en Docker se monta /app/uploads).
UPLOADS_DIR=uploads

# Cache local del modelo de embeddings (el modelo se descarga al usarlo por
# primera vez; en Docker se guarda en el volumen persistente /app/model-cache).
EMBEDDING_CACHE_DIR=.cache/embeddings

# Enlace de recuperacion: vigencia y limite de solicitudes por IP.
RECUPERACION_MINUTOS=30
RECUPERACION_MAX_INTENTOS=5
RECUPERACION_VENTANA_MINUTOS=15

# Correo saliente. Sin SMTP_HOST el enlace se escribe en el registro del
# servidor (modo consola), suficiente para desarrollo.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
SMTP_TLS=true
